<?xml version="1.0" encoding="utf-8"?>
<!-- Vintage brass oil lamp glowing over an open book — "reading by
     lamplight". Adaptive-icon safe zone is the center 66dp circle of the
     108dp canvas; the lamp is scaled/raised via the group below and the
     book's corners sit at radius ~33 from center so no launcher mask shape
     clips the scene. Layer order: lamp (with its glow halo) behind, book in
     front at its base. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.72"
        android:scaleY="0.72"
        android:translateY="-12">

        <!-- Soft glow halo radiating from the flame. -->
        <path android:pathData="M54,46 m-36,0 a36,36 0 1,0 72,0 a36,36 0 1,0 -72,0">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="radial"
                    android:centerX="54"
                    android:centerY="46"
                    android:gradientRadius="36"
                    android:startColor="#8CFFC24B"
                    android:centerColor="#38FFB74D"
                    android:endColor="#00FFB74D" />
            </aapt:attr>
        </path>

        <!-- Glass chimney (tulip shape), translucent warm white. -->
        <path
            android:pathData="M46.5,57 C44.5,50 44.5,44 47,38.5 C48.6,35 48.8,32 48.2,29.5 L59.8,29.5 C59.2,32 59.4,35 61,38.5 C63.5,44 63.5,50 61.5,57 Z"
            android:fillColor="#2EFFF3D6"
            android:strokeColor="#B08D57"
            android:strokeWidth="1.6" />

        <!-- Chimney top rim. -->
        <path
            android:pathData="M47,29.5 h14 v-1.6 a1.6,1.6 0 0,0 -1.6,-1.6 h-10.8 a1.6,1.6 0 0,0 -1.6,1.6 Z"
            android:fillColor="#B08D57" />

        <!-- Flame: outer amber teardrop + lighter core. -->
        <path
            android:pathData="M54,37.5 C57,41.5 58.6,44.6 58.6,47.4 C58.6,50.8 56.5,52.8 54,52.8 C51.5,52.8 49.4,50.8 49.4,47.4 C49.4,44.6 51,41.5 54,37.5 Z"
            android:fillColor="#FFB300" />
        <path
            android:pathData="M54,42 C55.7,44.4 56.6,46.2 56.6,47.9 C56.6,50 55.4,51.2 54,51.2 C52.6,51.2 51.4,50 51.4,47.9 C51.4,46.2 52.3,44.4 54,42 Z"
            android:fillColor="#FFE9A8" />

        <!-- Perforated gallery (brass collar between chimney and bowl). -->
        <path
            android:pathData="M45,57 h18 a1.5,1.5 0 0,1 1.5,1.5 v1 a1.5,1.5 0 0,1 -1.5,1.5 h-18 a1.5,1.5 0 0,1 -1.5,-1.5 v-1 a1.5,1.5 0 0,1 1.5,-1.5 Z"
            android:fillColor="#8C6D3F" />

        <!-- Fuel bowl with a vertical brass sheen. -->
        <path android:pathData="M44,61 C41.5,63.2 39.5,66.2 39.5,69 C39.5,73.8 46,76.5 54,76.5 C62,76.5 68.5,73.8 68.5,69 C68.5,66.2 66.5,63.2 64,61 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="54"
                    android:startY="61"
                    android:endX="54"
                    android:endY="76.5"
                    android:startColor="#C9A05C"
                    android:endColor="#8C6D3F" />
            </aapt:attr>
        </path>

        <!-- Wick-adjust knob on the right of the bowl. -->
        <path
            android:pathData="M66,66.6 h4.5 v2.8 h-4.5 Z"
            android:fillColor="#8C6D3F" />
        <path
            android:pathData="M72,68 m-2.4,0 a2.4,2.4 0 1,0 4.8,0 a2.4,2.4 0 1,0 -4.8,0"
            android:fillColor="#C9A05C" />

        <!-- Stem and saucer foot. -->
        <path
            android:pathData="M50,76.5 h8 v3.5 h-8 Z"
            android:fillColor="#8C6D3F" />
        <path android:pathData="M40,80 h28 a0,0 0 0,1 0,0 C68,83.4 62,85.5 54,85.5 C46,85.5 40,83.4 40,80 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="54"
                    android:startY="80"
                    android:endX="54"
                    android:endY="85.5"
                    android:startColor="#C9A05C"
                    android:endColor="#7A5C33" />
            </aapt:attr>
        </path>

        <!-- Chamberstick finger loop — the vintage "carry it to bed" cue. -->
        <path
            android:pathData="M73,79 m-4.6,0 a4.6,4.6 0 1,0 9.2,0 a4.6,4.6 0 1,0 -9.2,0"
            android:fillColor="#00000000"
            android:strokeColor="#B08D57"
            android:strokeWidth="2.4" />
    </group>

    <!-- Open book in front of the lamp's base. Dark cover slightly larger
         than the golden pages; corners kept within the safe-zone circle. -->
    <path
        android:pathData="M54,63.5 C46.5,60.3 37,59.8 31,61.9 L31,77.5 C37,75.4 46.5,75.8 54,79.6 C61.5,75.8 71,75.4 77,77.5 L77,61.9 C71,59.8 61.5,60.3 54,63.5 Z"
        android:fillColor="#5C4327" />

    <!-- Pages, golden like the lamp's brass. -->
    <path android:pathData="M53.3,64.8 C46.5,61.8 38.5,61.5 33,63.3 L33,75.7 C38.5,74.2 46.5,74.5 53.3,77.6 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="61.5"
                android:endX="54"
                android:endY="77.6"
                android:startColor="#EED9A6"
                android:endColor="#C9A05C" />
        </aapt:attr>
    </path>
    <path android:pathData="M54.7,64.8 C61.5,61.8 69.5,61.5 75,63.3 L75,75.7 C69.5,74.2 61.5,74.5 54.7,77.6 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="61.5"
                android:endX="54"
                android:endY="77.6"
                android:startColor="#EED9A6"
                android:endColor="#C9A05C" />
        </aapt:attr>
    </path>

    <!-- Spine shadow between the page spreads. -->
    <path
        android:pathData="M53.3,64.8 h1.4 v12.8 h-1.4 Z"
        android:fillColor="#7A5C33" />

    <!-- Cursive script lines: gentle two-wave strokes, three per page. -->
    <path
        android:pathData="M35.5,66.2 C39,65 42,66.4 45,65.6 C47.5,65 49.5,65.4 51,65.9"
        android:fillColor="#00000000"
        android:strokeColor="#8A6A38"
        android:strokeWidth="0.9"
        android:strokeLineCap="round" />
    <path
        android:pathData="M35.5,69.3 C39,68.1 42,69.5 45,68.7 C47.5,68.1 49.5,68.5 51,69"
        android:fillColor="#00000000"
        android:strokeColor="#8A6A38"
        android:strokeWidth="0.9"
        android:strokeLineCap="round" />
    <path
        android:pathData="M35.5,72.4 C39,71.2 42,72.6 45,71.8 C47.5,71.2 49.5,71.6 51,72.1"
        android:fillColor="#00000000"
        android:strokeColor="#8A6A38"
        android:strokeWidth="0.9"
        android:strokeLineCap="round" />
    <path
        android:pathData="M57,65.9 C58.5,65.4 60.5,65 63,65.6 C66,66.4 69,65 72.5,66.2"
        android:fillColor="#00000000"
        android:strokeColor="#8A6A38"
        android:strokeWidth="0.9"
        android:strokeLineCap="round" />
    <path
        android:pathData="M57,69 C58.5,68.5 60.5,68.1 63,68.7 C66,69.5 69,68.1 72.5,69.3"
        android:fillColor="#00000000"
        android:strokeColor="#8A6A38"
        android:strokeWidth="0.9"
        android:strokeLineCap="round" />
    <path
        android:pathData="M57,72.1 C58.5,71.6 60.5,71.2 63,71.8 C66,72.6 69,71.2 72.5,72.4"
        android:fillColor="#00000000"
        android:strokeColor="#8A6A38"
        android:strokeWidth="0.9"
        android:strokeLineCap="round" />
</vector>
