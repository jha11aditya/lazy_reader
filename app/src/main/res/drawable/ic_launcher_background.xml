<?xml version="1.0" encoding="utf-8"?>
<!-- Deep night sky: subtle radial lift at the center so the lamp's glow
     (foreground layer) feels like it's lighting the surrounding darkness. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0 h108 v108 h-108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="50"
                android:gradientRadius="70"
                android:startColor="#1C2B33"
                android:endColor="#0A141B" />
        </aapt:attr>
    </path>
</vector>
